{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    { "source": "/matches", "destination": "/index.html" },
    { "source": "/model", "destination": "/index.html" },
    { "source": "/watchlist", "destination": "/index.html" },
    { "source": "/match/:id", "destination": "/index.html" },
    { "source": "/league/:id", "destination": "/index.html" },
    { "source": "/team/:id", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }]
    }
  ]
}
